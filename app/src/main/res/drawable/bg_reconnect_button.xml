<?xml version="1.0" encoding="utf-8"?>
<!-- Filled violet pill background for the Reconnect button, following the
     same rounded-shape convention as bg_status_pill.xml. Wrapped in a
     ripple so the button gives touch feedback (minSdk 24, well above the
     API 21 ripple requirement). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_violet_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_violet" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
